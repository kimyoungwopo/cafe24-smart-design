[
  {
    "name": "cut",
    "purpose": "String truncation",
    "syntax": "{$v|cut:length,suffix}",
    "example": "{$product_name|cut:20,...}",
    "source": "references/modifiers-and-syntax.md"
  },
  {
    "name": "numberformat",
    "purpose": "Thousands separator",
